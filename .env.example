# University of Hertfordshire (UH) Block Storage (S3/MinIO) Configuration Example
# Copy this file to .env and insert your authorized credentials.
# NOTE: .env is ignored by Git and must NEVER be committed.

UH_S3_ENDPOINT_URL=http://vuh-la-specs-s3-1.herts.ac.uk:9000
UH_S3_ACCESS_KEY=your_access_key_here
UH_S3_SECRET_KEY=your_secret_key_here
UH_S3_BUCKET_NAME=comsci-student-s3-1

