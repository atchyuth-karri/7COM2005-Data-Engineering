import time
import joblib
import matplotlib.pyplot as plt
import numpy as np
import pandas as pd
import seaborn as sns
from sklearn.ensemble import (
    GradientBoostingClassifier,
    RandomForestClassifier,
    VotingClassifier,
)
from sklearn.linear_model import LogisticRegression
from sklearn.metrics import (
    accuracy_score,
    classification_report,
    confusion_matrix,
    f1_score,
    roc_auc_score,
)
from sklearn.model_selection import GridSearchCV, train_test_split
from sklearn.preprocessing import StandardScaler
from sklearn.svm import SVC

# ==========================================
# 1. LOAD DATASET FROM GITHUB
# ==========================================
parquet_url = "https://raw.githubusercontent.com/atchyuth-karri/7COM2005-Data-Engineering/main/PerfectPetClub/data/processed/customer_churn_dataset.parquet"

print("Loading customer_churn_dataset.parquet from GitHub...")
df = pd.read_parquet(parquet_url)
print(f"Dataset successfully loaded! Shape: {df.shape}\n")

# ==========================================
# 2. PREPROCESSING & STRATIFIED SPLIT
# ==========================================
X = df.drop(columns=['customer_id', 'auto_renew'])
y = df['auto_renew']

# One-hot encode categorical features
X = pd.get_dummies(X, drop_first=True)

# 80/20 Stratified Split
X_train, X_test, y_train, y_test = train_test_split(
    X, y, test_size=0.20, random_state=42, stratify=y
)

# Feature Scaling (for SVM, Logistic Regression, and KNN)
scaler = StandardScaler()
X_train_scaled = scaler.fit_transform(X_train)
X_test_scaled = scaler.transform(X_test)

# ==========================================
# 3. HYPERPARAMETER TUNING & TRAINING (>89% ACCURACY)
# ==========================================
print("Tuning hyperparameters to maximize accuracy (>89% target)...")

# Random Forest Optimization
rf_params = {
    'n_estimators': [100, 200, 300],
    'max_depth': [4, 6, 8, 10],
    'min_samples_split': [2, 5],
}
rf_grid = GridSearchCV(
    RandomForestClassifier(random_state=42, class_weight='balanced'),
    rf_params,
    cv=5,
    scoring='accuracy',
)
rf_grid.fit(X_train, y_train)
best_rf = rf_grid.best_estimator_

# Gradient Boosting Optimization
gb_params = {
    'n_estimators': [50, 100, 150],
    'learning_rate': [0.01, 0.05, 0.1],
    'max_depth': [3, 4, 5],
}
gb_grid = GridSearchCV(
    GradientBoostingClassifier(random_state=42),
    gb_params,
    cv=5,
    scoring='accuracy',
)
gb_grid.fit(X_train, y_train)
best_gb = gb_grid.best_estimator_

# SVM Optimization
svm_params = {'C': [0.1, 1, 10, 100], 'gamma': ['scale', 'auto', 0.01, 0.1]}
svm_grid = GridSearchCV(
    SVC(probability=True, random_state=42, class_weight='balanced'),
    svm_params,
    cv=5,
    scoring='accuracy',
)
svm_grid.fit(X_train_scaled, y_train)
best_svm = svm_grid.best_estimator_

# ==========================================
# 4. MODEL EVALUATION & COMPARISON
# ==========================================
models_to_test = {
    'Tuned Random Forest': (best_rf, X_test),
    'Tuned Gradient Boosting': (best_gb, X_test),
    'Tuned SVM': (best_svm, X_test_scaled),
}

performance_results = []
best_score = 0
final_best_model = None

print('\n--- Evaluating Tuned Models on Test Set ---')
for name, (model, x_data) in models_to_test.items():
  y_pred = model.predict(x_data)
  y_prob = model.predict_proba(x_data)[:, 1]

  acc = accuracy_score(y_test, y_pred)
  f1 = f1_score(y_test, y_pred, average='weighted')
  roc = roc_auc_score(y_test, y_prob)

  performance_results.append({
      'Model': name,
      'Accuracy': acc,
      'F1-Score': f1,
      'ROC-AUC': roc,
  })

  print(f'\nModel: {name}')
  print(f'  > Test Accuracy : {acc * 100:.2f}%')
  print(f'  > F1-Score      : {f1:.4f}')
  print(f'  > ROC-AUC       : {roc:.4f}')

  if acc > best_score:
    best_score = acc
    final_best_model = model

results_df = pd.DataFrame(performance_results).sort_values(
    by='Accuracy', ascending=False
)

# ==========================================
# 5. VISUALIZATIONS (Matplotlib & Seaborn)
# ==========================================
sns.set_theme(style='whitegrid')

# A. Model Performance Bar Chart
plt.figure(figsize=(9, 5))
plot_df = results_df.melt(
    id_vars='Model',
    value_vars=['Accuracy', 'F1-Score', 'ROC-AUC'],
    var_name='Metric',
    value_name='Score',
)
ax = sns.barplot(
    x='Model', y='Score', hue='Metric', data=plot_df, palette='magma'
)
plt.title(
    'Tuned Models Performance Comparison (Target: >89% Accuracy)',
    fontsize=13,
    fontweight='bold',
)
plt.ylim(0, 1.1)
plt.xticks(rotation=10)
plt.legend(loc='lower right')

for p in ax.patches:
  height = p.get_height()
  if height > 0:
    ax.annotate(
        f'{height:.2f}',
        (p.get_x() + p.get_width() / 2.0, height),
        ha='center',
        va='bottom',
        fontsize=9,
        xytext=(0, 3),
        textcoords='offset points',
    )
plt.tight_layout()
plt.show()

# B. Confusion Matrix for Best Model
best_x_data = (
    X_test_scaled
    if isinstance(final_best_model, SVC)
    else X_test
)
y_pred_best = final_best_model.predict(best_x_data)
cm = confusion_matrix(y_test, y_pred_best)

plt.figure(figsize=(7, 5))
sns.heatmap(
    cm,
    annot=True,
    fmt='d',
    cmap='Blues',
    cbar=False,
    linewidths=1,
    linecolor='lightgray',
    xticklabels=['Churn (0)', 'Retained (1)'],
    yticklabels=['Churn (0)', 'Retained (1)'],
)
plt.title(
    'Confusion Matrix - Best Tuned Model', fontsize=13, fontweight='bold', pad=15
)
plt.xlabel('Predicted Label', fontsize=11, fontweight='bold')
plt.ylabel('Actual Label', fontsize=11, fontweight='bold')
plt.tight_layout()
plt.show()

# ==========================================
# 6. MODEL PERSISTENCE
# ==========================================
joblib.dump(final_best_model, 'best_churn_model.pkl')
joblib.dump(scaler, 'feature_scaler.pkl')
print(
    f'\n🏆 Best Model saved successfully with {best_score * 100:.2f}% accuracy!'
)
print("Artifacts saved: 'best_churn_model.pkl' & 'feature_scaler.pkl'")
